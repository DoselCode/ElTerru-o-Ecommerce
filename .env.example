# ==============================================================================
# SELECCIÓN DE BACKEND (Híbrido: InsForge en dev, Supabase en producción/Vercel)
# ==============================================================================

# Opcional: forzar backend explícito ('insforge' | 'supabase')
# VITE_BACKEND_PROVIDER=insforge

# --- DESARROLLO (InsForge) ---
# Usado por defecto en local si están configuradas estas variables:
VITE_INSFORGE_URL=https://your-project.insforge.app
VITE_INSFORGE_ANON_KEY=anon_xxxxxxxxxxxxxxxx

# --- PRODUCCIÓN (Supabase / Vercel) ---
# Configurar estas variables en el panel de Vercel para producción:
# VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

